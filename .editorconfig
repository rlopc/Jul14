# Shared editor defaults; language-specific rules come with the project stack
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Upstream license text is kept verbatim, with its own alignment
[LICENSE]
indent_style = unset
indent_size = unset
